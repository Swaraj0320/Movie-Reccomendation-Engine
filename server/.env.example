# Copy this file to .env and replace the placeholder values.
MONGODB_URL=mongodb+srv://<USERNAME>:S<password>@cluster0.u78kznx.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=movie_recommendation
TMDB_API_KEY=your_tmdb_api_key
# Generate a long random value; never commit your real secret.
SECRET_KEY=replace_with_a_long_random_secret
# Used only to grant the hidden admin route after a normal successful login.
ADMIN_EMAIL=admin@example.com
# Add additional existing administrator emails, separated by commas.
ADMIN_EMAILS=admin@example.com,another-admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
